<%- include('partials/header') %>

<div class="auth-wrap">
  <div class="auth-card">
    <h2 class="display">تسجيل الدخول</h2>
    <p class="sub">مرحباً بعودتك</p>

    <div class="social-row" style="margin-top:24px;">
      <a href="/auth/google" class="social-btn google">دخول عبر Google</a>
      <a href="/auth/facebook" class="social-btn facebook">دخول عبر Facebook</a>
    </div>

    <div class="divider">أو</div>

    <form method="POST" action="/login">
      <div class="field">
        <label>اسم المستخدم أو رقم الهاتف</label>
        <input type="text" name="identifier" required />
      </div>
      <div class="field">
        <label>كلمة السر</label>
        <input type="password" name="password" required />
      </div>
      <button type="submit" class="btn btn-primary">دخول</button>
    </form>

    <% if (error) { %><div class="error-msg"><%= error %></div><% } %>

    <p class="switch-line">ما عندك حساب؟ <a href="/signup">إنشاء حساب جديد</a></p>
    <p class="switch-line" style="margin-top:6px;"><a href="/admin/login">دخول المالك (Admin)</a></p>
  </div>
</div>

 <%- include('partials/footer') %>

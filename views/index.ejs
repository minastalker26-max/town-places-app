<%- include('partials/header') %>

<section class="hero">
  <h1 class="display">اكتشف أفضل الأماكن<br/>في مدينتك</h1>
  <p>دليل محلي لأماكن مختارة بعناية — قيّم، واستكشف، وشارك رأيك مع باقي السكان.</p>
</section>

<section class="section">
  <div class="grid">
    <% if (places.length === 0) { %>
      <p style="color:var(--ink-soft)">ما زال ما فيه أماكن مضافة. تابعونا قريباً!</p>
    <% } %>
    <% places.forEach(function(place) { %>
      <a href="/place/<%= place._id %>" class="card">
        <div class="card-media">
          <% if (place.image) { %>
            <img src="<%= place.image %>" alt="<%= place.name %>" />
          <% } else { %>
            <div class="fallback"><%= place.name.charAt(0) %></div>
          <% } %>
          <div class="rating-badge">★ <%= place.averageRating || "جديد" %></div>
        </div>
        <div class="card-body">
          <div class="category"><%= place.category %></div>
          <h3><%= place.name %></h3>
          <p><%= place.description %></p>
          <div class="address"><%= place.address %></div>
        </div>
      </a>
    <% }); %>
  </div>
</section>

 <%- include('partials/footer') %>

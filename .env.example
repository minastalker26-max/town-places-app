# ==== انسخ هذا الملف وسمّه .env وعبّي القيم ====

# رابط قاعدة البيانات (من MongoDB Atlas)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/townPlaces

# مفتاح سري لتشفير الجلسات (اكتب أي نص عشوائي طويل)
SESSION_SECRET=change_this_to_a_long_random_string

# بيانات حساب الأدمن (المالك)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Rivaldo123

# Google OAuth (من Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Facebook OAuth (من Facebook Developers)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:3000/auth/facebook/callback

# بريد Gmail لإرسال نسخة قاعدة البيانات (txt) عند كل تحديث
GMAIL_USER=minastalker26@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# رابط الموقع بعد النشر (تستخدمه لاحقاً)
BASE_URL=http://localhost:3000

PORT=3000
